# sshd for the `real-sshd` integration tier (AC-T2). Reviewed in this repo on
# purpose: the settings below are what the tier proves, so they must not be
# inherited from whatever a base image happens to ship.

Port 22
AddressFamily any
ListenAddress 0.0.0.0

# The key material is generated by `ssh-keygen -A` at image build time. Tests do
# not hardcode a fingerprint; they read it from the first connection and pin
# that (probeRealSshd in tests/fixtures/endpoints.ts).
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

# AC-T4, first item. With StrictModes on, sshd refuses a key whose
# `~/.ssh`/`authorized_keys` modes or ownership are loose — so a green key-only
# reconnect is the proof that the setup flow installed 0700/0600 correctly.
StrictModes yes

PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

# Password auth is the account the tier bootstraps with: the setup flow's whole
# job is to turn a password login into a key login, and it cannot be exercised
# on a host that only ever accepted keys.
PasswordAuthentication yes
PermitEmptyPasswords no
KbdInteractiveAuthentication no
PermitRootLogin no

UsePAM yes

# AC-T4, fourth item. The real subsystem, not an in-process emulation.
Subsystem sftp /usr/lib/openssh/sftp-server

# The suite runs test files in parallel and `lifecycle (AC15)` opens five shell
# channels on a single connection before asserting the sixth is refused by us.
# The defaults (MaxSessions 10, MaxStartups 10:30:100) would make sshd the thing
# that says no, and the test would pass for the wrong reason.
MaxSessions 50
MaxStartups 100:30:200

# VERBOSE logs the key fingerprint and the auth method per attempt, which is
# what the `docker logs` artifact needs to be worth uploading (PM-5).
LogLevel VERBOSE

PrintMotd no
PrintLastLog no
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
PermitUserEnvironment no

# Tests idle between assertions (idle-reaper legs wait seconds at a time);
# nothing here should be killed for being quiet.
ClientAliveInterval 0
TCPKeepAlive yes
